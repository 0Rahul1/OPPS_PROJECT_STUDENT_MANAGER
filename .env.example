# Database Connection Configuration for Student Management System
# Copy this file to '.env' and configure with your credentials.
# NOTE: '.env' is excluded from Git version control to protect your credentials.

# Active Database Engine: 'mysql' (Relational SQL) or 'mongodb' (Document NoSQL)
DB_TYPE=mysql

# ------------------------------------------------------------------------------
# MySQL Configuration (Port 3306 - Classic Protocol)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YourMySQLPasswordHere
DB_NAME=student_management

# ------------------------------------------------------------------------------
# MongoDB Configuration (Local or MongoDB Atlas)
# ------------------------------------------------------------------------------
# Local MongoDB: mongodb://127.0.0.1:27017
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=student_management
